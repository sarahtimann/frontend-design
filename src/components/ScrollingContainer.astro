---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    overflow-inline: auto;
    list-style: none;
    padding: 0;
    gap: var(--card-gap);
    /* padding-inline: 3rem; */
    
    padding-inline: max(1rem, 50% - var(--content-width) / 2);
    /* scroll-padding-inline: max(1rem, 50% - var(--content-width) / 2); */
    
    scroll-snap-type: x mandatory;
  }
  
  li {
    /* scroll-snap-align: start; */
    
    flex: 1 0 400px;
    background: var(--card-background);
    color: var(--card-text-color);
    padding: var(--card-padding);
    border-radius: 1rem;
  }
</style>
