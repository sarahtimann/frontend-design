---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    overflow-x: auto;
    list-style: none;
    padding: 0;
  }

  li {
    flex: 1 0 30%;
  }
</style>
